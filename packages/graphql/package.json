{
  "name": "@axiomify/graphql",
  "version": "7.0.0",
  "description": "GraphQL plugin for Axiomify — schema-first, zero-boilerplate GraphQL endpoint with built-in GraphiQL playground.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@axiomify/core": "*",
    "graphql": "^16.14.2"
  },
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "keywords": [
    "axiomify",
    "graphql",
    "graphiql",
    "schema-first",
    "playground",
    "api",
    "middleware",
    "validation"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/graphql.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/graphql"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
