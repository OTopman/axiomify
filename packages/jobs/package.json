{
  "name": "@axiomify/jobs",
  "version": "6.3.1",
  "description": "Distributed Job Scheduler, Worker, and Saga Coordinator for Axiomify.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@axiomify/core": "*"
  },
  "devDependencies": {
    "@axiomify/core": "*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
