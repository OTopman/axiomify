{
  "name": "@axiomify/cli",
  "version": "6.0.0",
  "description": "Official CLI for Axiomify — scaffold, dev, build, route inspection, OpenAPI generation, production-readiness checks, host diagnostics, codemod migrations.",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "axiomify": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@axiomify/core": "*",
    "commander": "12.0.0",
    "enquirer": "^2.4.1",
    "esbuild": "^0.28.0",
    "execa": "^8.0.1",
    "picocolors": "^1.1.1"
  },
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/cli.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
