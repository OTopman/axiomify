{
  "name": "@axiomify/cli",
  "version": "7.0.1",
  "description": "Official CLI for Axiomify — scaffold, dev, build, route inspection, OpenAPI generation, production-readiness checks, host diagnostics, codemod migrations.",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui-dist"
  ],
  "bin": {
    "axiomify": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@axiomify/core": "*",
    "commander": "12.1.0",
    "enquirer": "^2.4.1",
    "esbuild": "^0.28.1",
    "execa": "^8.0.1",
    "graphql": "^16.14.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "keywords": [
    "axiomify",
    "cli",
    "scaffold",
    "dev-server",
    "build-tool",
    "route-inspection",
    "openapi",
    "production-checks",
    "codemod"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/cli.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
