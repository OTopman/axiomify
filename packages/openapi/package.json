{
  "name": "@axiomify/openapi",
  "version": "6.2.1",
  "description": "OpenAPI 3.0.3 generator + Swagger UI for Axiomify — Zod-v4-native via `z.toJSONSchema()`, 100% Operation Object coverage.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@axiomify/core": "*",
    "zod-to-json-schema": "3.25.2"
  },
  "keywords": [
    "axiomify",
    "openapi",
    "swagger-ui",
    "api-docs",
    "zod",
    "json-schema",
    "documentation"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/openapi.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/openapi"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
