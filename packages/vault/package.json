{
  "name": "@axiomify/vault",
  "version": "6.3.3",
  "description": "Secure Environment Management & Vault Engine for Axiomify.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.mjs",
      "require": "./dist/proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@axiomify/core": "*"
  },
  "devDependencies": {
    "@axiomify/core": "*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-grpc": "0.219.0",
    "@opentelemetry/sdk-node": "0.219.0"
  }
}
