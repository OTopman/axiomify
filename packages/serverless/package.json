{
  "name": "@axiomify/serverless",
  "version": "7.0.0",
  "description": "Platform-independent serverless adapter for Axiomify using Web standard Request/Response objects (WinterCG compliant).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run tests --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@axiomify/core": "^7.0.0"
  },
  "keywords": [
    "axiomify",
    "serverless",
    "adapter",
    "fetch",
    "request",
    "response",
    "wintercg",
    "cloudflare-workers",
    "vercel-edge",
    "aws-lambda",
    "bun",
    "deno"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/serverless.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/serverless"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
