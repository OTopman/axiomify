{
  "name": "@axiomify/socket.io",
  "version": "6.0.0-rc.2",
  "description": "Socket.IO bridge for @axiomify/native — attach Socket.IO to the same uWebSockets.js server that handles HTTP, so you only need one listener.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@axiomify/core": "*",
    "@axiomify/native": "*"
  },
  "peerDependencies": {
    "socket.io": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "socket.io": {
      "optional": false
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "module": "./dist/index.mjs",
  "engines": {
    "node": ">=18.0.0 <23.0.0"
  },
  "keywords": [
    "axiomify",
    "socket.io",
    "socketio",
    "websocket",
    "uwebsockets",
    "realtime"
  ],
  "license": "MIT"
}
