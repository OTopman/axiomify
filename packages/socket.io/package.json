{
  "name": "@axiomify/socket.io",
  "version": "7.1.0",
  "description": "Socket.IO bridge for @axiomify/native — attach Socket.IO to the same uWebSockets.js server that handles HTTP, so you only need one listener.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run tests --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@axiomify/core": "^7.1.0",
    "@axiomify/native": "^7.1.0"
  },
  "peerDependencies": {
    "socket.io": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "socket.io": {
      "optional": false
    }
  },
  "keywords": [
    "axiomify",
    "socket.io",
    "socket.io-bridge",
    "socketio",
    "websocket",
    "uwebsockets",
    "native-adapter",
    "realtime"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/socket.io.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/socket.io"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0 || >=24.0.0 <25.0.0"
  }
}
