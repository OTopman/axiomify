{
  "name": "@axiomify/fingerprint",
  "version": "6.3.2",
  "description": "Server-side request fingerprinting for Axiomify — confidence-scored client identification from headers, IP, and TLS hints.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@axiomify/core": "*"
  },
  "keywords": [
    "axiomify",
    "fingerprinting",
    "request-fingerprint",
    "bot-detection",
    "fraud-prevention",
    "session-security",
    "http-headers"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/fingerprint.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/fingerprint"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
