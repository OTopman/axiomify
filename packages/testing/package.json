{
  "name": "@axiomify/testing",
  "version": "7.0.1",
  "description": "Inject-style testing utilities for Axiomify — no sockets, no ports: build requests, capture responses, assert against route Zod schemas.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run tests --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@axiomify/core": "^7.0.0"
  },
  "peerDependencies": {
    "zod": ">=3.20 <5"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  },
  "keywords": [
    "axiomify",
    "testing",
    "inject",
    "test-utilities",
    "mock",
    "http-testing"
  ],
  "author": {
    "name": "Topman",
    "email": "okunlolatopman14@gmail.com",
    "url": "https://github.com/OTopman"
  },
  "license": "MIT",
  "homepage": "https://github.com/OTopman/axiomify/blob/main/docs/packages/testing.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTopman/axiomify.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/OTopman/axiomify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
