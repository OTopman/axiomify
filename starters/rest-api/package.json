{
  "name": "axiomify-rest-api-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented REST API starter for Axiomify",
  "scripts": {
    "dev": "axiomify dev src/index.ts",
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axiomify/core": "^7.0.1",
    "@axiomify/cors": "^7.0.1",
    "@axiomify/helmet": "^7.0.1",
    "@axiomify/logger": "^7.0.1",
    "@axiomify/native": "^7.0.1",
    "@axiomify/observability": "^7.0.1",
    "@axiomify/rate-limit": "^7.0.1",
    "@axiomify/security": "^7.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axiomify/cli": "^7.0.1",
    "@axiomify/testing": "^7.0.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  },
  "engines": { "node": ">=20.0.0 <23.0.0" }
}
