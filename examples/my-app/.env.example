# Copy this file to .env and replace the placeholders below before running
# `npm run dev`. The example app reads these via process.env.
#
# JWT_SECRET must be at least 32 characters. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=changeme-please-set-a-32-char-secret-from-crypto-randomBytes
NODE_ENV=development