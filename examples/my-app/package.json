{
  "name": "axiomify-app",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "axiomify dev src/index.ts",
    "dev:sdk": "axiomify dev src/index.ts --watch-sdk typescript python",
    "build": "echo \"Skipping example build in CI — run npm run dev locally\"",
    "start": "node dist/index.js",
    "routes": "axiomify routes src/index.ts",
    "sdk:generate": "axiomify sdk generate src/index.ts -t typescript python go"
  },
  "dependencies": {
    "@axiomify/auth": "*",
    "@axiomify/core": "*",
    "@axiomify/graphql": "*",
    "@axiomify/helmet": "*",
    "@axiomify/logger": "*",
    "@axiomify/native": "*",
    "@axiomify/openapi": "*",
    "@axiomify/static": "*",
    "@axiomify/upload": "*",
    "graphql": "^16.14.1"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "axiomify",
    "example",
    "starter",
    "typescript",
    "graphql",
    "openapi",
    "authentication",
    "static-files",
    "file-upload"
  ]
}
