{
  "name": "axiomify-app",
  "version": "8.0.0",
  "private": true,
  "scripts": {
    "dev": "axiomify dev src/index.ts",
    "dev:sdk": "axiomify dev src/index.ts --watch-sdk typescript python",
    "build": "echo \"Skipping example build in CI — run npm run dev locally\"",
    "start": "node dist/index.js",
    "routes": "axiomify routes src/index.ts",
    "sdk:generate": "axiomify sdk generate src/index.ts -t typescript python go",
    "client": "ts-node src/client.ts"
  },
  "dependencies": {
    "@axiomify/auth": "*",
    "@axiomify/core": "*",
    "@axiomify/cors": "*",
    "@axiomify/fingerprint": "*",
    "@axiomify/graphql": "*",
    "@axiomify/helmet": "*",
    "@axiomify/jobs": "*",
    "@axiomify/logger": "*",
    "@axiomify/metrics": "*",
    "@axiomify/native": "*",
    "@axiomify/openapi": "*",
    "@axiomify/rate-limit": "*",
    "@axiomify/sdk-runtime": "*",
    "@axiomify/security": "*",
    "@axiomify/socket.io": "*",
    "@axiomify/static": "*",
    "@axiomify/upload": "*",
    "@axiomify/vault": "*",
    "@axiomify/ws": "*",
    "graphql": "^16.14.1",
    "socket.io": "^4.4.0",
    "tsup": "^8.5.1"
  },
  "devDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io-client": "^4.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "axiomify",
    "example",
    "starter",
    "typescript",
    "graphql",
    "openapi",
    "authentication",
    "static-files",
    "file-upload"
  ]
}
